From e27c0eb308ecd0d5151a2409730a0eab26c27090 Mon Sep 17 00:00:00 2001
From: Fede2782 <78815152+Fede2782@users.noreply.github.com>
Date: Wed, 8 Apr 2026 17:00:21 +0200
Subject: [PATCH] Use target values for Device IDs Attestation

Co-authored-by: mediaserver64 <mediaserver479@gmail.com>
---
 smali_classes3/android/os/Build.smali | 59 +++++++++++++++++----------
 1 file changed, 38 insertions(+), 21 deletions(-)

diff --git a/smali_classes3/android/os/Build.smali b/smali_classes3/android/os/Build.smali
index 4c51854..77e24a5 100644
--- a/smali_classes3/android/os/Build.smali
+++ b/smali_classes3/android/os/Build.smali
@@ -177,28 +177,53 @@
 
     sput-object v0, Landroid/os/Build;->PRODUCT:Ljava/lang/String;
 
-    const-string/jumbo v0, "name"
+	const-string/jumbo v0, "ro.boot.em.model"
 
-    invoke-static {v0}, Landroid/os/Build;->getVendorDeviceIdProperty(Ljava/lang/String;)Ljava/lang/String;
+    invoke-static {v0}, Landroid/os/Build;->getString(Ljava/lang/String;)Ljava/lang/String;
 
     move-result-object v0
 
-    sput-object v0, Landroid/os/Build;->PRODUCT_FOR_ATTESTATION:Ljava/lang/String;
+    const-string/jumbo v1, "SM-A146B"
 
-    const-string/jumbo v0, "ro.product.device"
+	invoke-virtual {v0, v1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
 
-    invoke-static {v0}, Landroid/os/Build;->getString(Ljava/lang/String;)Ljava/lang/String;
+	move-result v1
 
-    move-result-object v0
+	if-eqz v1, :cond_3
+
+	const-string/jumbo v0, "a14xxx"
+
+	goto :goto_2
+
+	:cond_3
+	const-string/jumbo v1, "SM-A146M"
+
+	invoke-virtual {v0, v1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+	move-result v1
+
+	if-eqz v1, :cond_4
+
+	const-string/jumbo v0, "a14xub"
+
+	goto :goto_2
 
-    sput-object v0, Landroid/os/Build;->DEVICE:Ljava/lang/String;
+	:cond_4
+	const-string/jumbo v0, "a14xxx"
 
-    const-string v0, "device"
+	:goto_2
+	sput-object v0, Landroid/os/Build;->PRODUCT_FOR_ATTESTATION:Ljava/lang/String;
 
-    invoke-static {v0}, Landroid/os/Build;->getVendorDeviceIdProperty(Ljava/lang/String;)Ljava/lang/String;
+	const-string/jumbo v0, "ro.product.device"
+
+	invoke-static {v0}, Landroid/os/Build;->getString(Ljava/lang/String;)Ljava/lang/String;
 
     move-result-object v0
 
+	sput-object v0, Landroid/os/Build;->DEVICE:Ljava/lang/String;
+
+	const-string v0, "a54x"
+
     sput-object v0, Landroid/os/Build;->DEVICE_FOR_ATTESTATION:Ljava/lang/String;
 
     const-string/jumbo v0, "ro.product.board"
@@ -217,11 +242,7 @@
 
     sput-object v0, Landroid/os/Build;->MANUFACTURER:Ljava/lang/String;
 
-    const-string/jumbo v0, "manufacturer"
-
-    invoke-static {v0}, Landroid/os/Build;->getVendorDeviceIdProperty(Ljava/lang/String;)Ljava/lang/String;
-
-    move-result-object v0
+    const-string/jumbo v0, "samsung"
 
     sput-object v0, Landroid/os/Build;->MANUFACTURER_FOR_ATTESTATION:Ljava/lang/String;
 
@@ -233,11 +254,7 @@
 
     sput-object v0, Landroid/os/Build;->BRAND:Ljava/lang/String;
 
-    const-string v0, "brand"
-
-    invoke-static {v0}, Landroid/os/Build;->getVendorDeviceIdProperty(Ljava/lang/String;)Ljava/lang/String;
-
-    move-result-object v0
+    const-string/jumbo v0, "samsung"
 
     sput-object v0, Landroid/os/Build;->BRAND_FOR_ATTESTATION:Ljava/lang/String;
 
@@ -249,9 +266,9 @@
 
     sput-object v0, Landroid/os/Build;->MODEL:Ljava/lang/String;
 
-    const-string/jumbo v0, "model"
+    const-string/jumbo v0, "ro.boot.em.model"
 
-    invoke-static {v0}, Landroid/os/Build;->getVendorDeviceIdProperty(Ljava/lang/String;)Ljava/lang/String;
+    invoke-static {v0}, Landroid/os/Build;->getString(Ljava/lang/String;)Ljava/lang/String;
 
     move-result-object v0
 
